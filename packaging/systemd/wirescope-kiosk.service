[Unit]
Description=WireScope local operator kiosk
Documentation=file:///opt/wirescope/docs/INSTALLATION.md
After=wirescope-api.service getty@tty1.service systemd-user-sessions.service
Wants=wirescope-api.service
Conflicts=getty@tty1.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=wirescope
Group=wirescope
SupplementaryGroups=video
WorkingDirectory=/opt/wirescope
EnvironmentFile=-/etc/wirescope/wirescope.env
Environment=HOME=/var/lib/wirescope
Environment=XDG_RUNTIME_DIR=/run/wirescope-kiosk
Environment=XDG_SESSION_TYPE=wayland
Environment=WLR_LIBSEAT_BACKEND=logind
Environment=WIRESCOPE_KIOSK_URL=http://127.0.0.1:8000/
RuntimeDirectory=wirescope-kiosk
RuntimeDirectoryMode=0700
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty
UtmpIdentifier=tty1
UtmpMode=user
ExecStartPre=/opt/wirescope/.venv/bin/python -m appliance wait-ready
ExecStart=/opt/wirescope/packaging/kiosk/kiosk.sh
Restart=on-failure
RestartPreventExitStatus=75
RestartSec=2
TimeoutStartSec=90
TimeoutStopSec=15
StandardOutput=journal
StandardError=journal
SyslogIdentifier=wirescope-kiosk

[Install]
WantedBy=multi-user.target
