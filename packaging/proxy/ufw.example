# Example ufw commands. Replace 192.0.2.0/24 with the management network.
# Do not run these blindly on a remote SSH host.

ufw allow OpenSSH
ufw allow from 192.0.2.0/24 to any port 443 proto tcp
ufw deny 8000/tcp
ufw enable
ufw status verbose

# Direct TLS without a proxy (less preferred):
# ufw allow from 192.0.2.0/24 to any port 8443 proto tcp
