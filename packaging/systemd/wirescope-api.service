[Unit]
Description=WireScope application API
Documentation=file:///opt/wirescope/docs/INSTALLATION.md
After=network-online.target local-fs.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=wirescope
Group=wirescope
SupplementaryGroups=wireshark
WorkingDirectory=/opt/wirescope
EnvironmentFile=-/etc/wirescope/wirescope.env
Environment=HOME=/var/lib/wirescope
ExecStart=/opt/wirescope/.venv/bin/python -m backend
ExecStartPost=/opt/wirescope/.venv/bin/python -m appliance wait-ready
Restart=on-failure
RestartSec=3
TimeoutStartSec=90
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal
SyslogIdentifier=wirescope-api
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/var/lib/wirescope /etc/wirescope /etc/network /etc/NetworkManager /etc/systemd/network

[Install]
WantedBy=multi-user.target
