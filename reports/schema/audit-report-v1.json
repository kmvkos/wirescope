{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wirescope.local/schema/audit-report-v1.json",
  "title": "WireScope audit report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "report_id",
    "generated_at",
    "source_hash",
    "audit",
    "executive_summary",
    "environment",
    "passive",
    "scope",
    "assets",
    "services",
    "findings",
    "recommendations",
    "evidence_references",
    "metadata"
  ],
  "properties": {
    "schema": { "type": "string", "const": "audit-report" },
    "schema_version": { "type": "integer", "const": 1 },
    "report_id": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "minLength": 1 },
    "source_hash": { "type": "string", "minLength": 64 },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "profile",
        "interface",
        "actor",
        "created_at",
        "started_at",
        "finished_at",
        "summary"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "minLength": 1 },
        "profile": { "type": "string", "minLength": 1 },
        "interface": { "type": ["string", "null"] },
        "actor": { "type": ["string", "null"] },
        "created_at": { "type": "string", "minLength": 1 },
        "started_at": { "type": ["string", "null"] },
        "finished_at": { "type": ["string", "null"] },
        "summary": { "type": "object" }
      }
    },
    "executive_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "headline",
        "asset_count",
        "service_count",
        "finding_count",
        "open_finding_count",
        "by_severity",
        "by_status",
        "highest_open_severity",
        "confirmed_scope",
        "detected_sensors",
        "frame_count",
        "had_l3_address",
        "tagged_vlan_ids",
        "segment_status",
        "segment_note"
      ],
      "properties": {
        "headline": { "type": "string", "minLength": 1 },
        "asset_count": { "type": "integer", "minimum": 0 },
        "service_count": { "type": "integer", "minimum": 0 },
        "finding_count": { "type": "integer", "minimum": 0 },
        "open_finding_count": { "type": "integer", "minimum": 0 },
        "by_severity": {
          "type": "object",
          "additionalProperties": { "type": "integer" }
        },
        "by_status": {
          "type": "object",
          "additionalProperties": { "type": "integer" }
        },
        "highest_open_severity": {
          "type": ["string", "null"],
          "enum": ["critical", "high", "medium", "low", "info", null]
        },
        "confirmed_scope": { "type": "boolean" },
        "detected_sensors": {
          "type": "array",
          "items": { "type": "string" }
        },
        "frame_count": { "type": ["integer", "null"], "minimum": 0 },
        "had_l3_address": { "type": ["boolean", "null"] },
        "tagged_vlan_ids": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0, "maximum": 4095 }
        },
        "segment_status": {
          "type": "string",
          "enum": [
            "unknown",
            "quiet",
            "very_low",
            "tagged_vlans",
            "untagged_traffic",
            "active"
          ]
        },
        "segment_note": { "type": "string", "minLength": 1 }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hostname", "capture_interface", "had_l3_address", "interfaces", "default_route", "dns"],
      "properties": {
        "hostname": { "type": ["string", "null"] },
        "capture_interface": { "type": ["string", "null"] },
        "had_l3_address": { "type": ["boolean", "null"] },
        "interfaces": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "state", "mac", "ipv4", "ipv6"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "state": { "type": ["string", "null"] },
              "mac": { "type": ["string", "null"] },
              "ipv4": { "type": "array", "items": { "type": "string" } },
              "ipv6": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "default_route": {
          "anyOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["gateway", "interface"],
              "properties": {
                "gateway": { "type": ["string", "null"] },
                "interface": { "type": ["string", "null"] }
              }
            }
          ]
        },
        "dns": { "type": "array", "items": { "type": "string" } }
      }
    },
    "passive": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "available",
        "capture_interface",
        "capture_interface_state",
        "capture_mac",
        "capture_ipv4",
        "capture_ipv6",
        "had_l3_address",
        "duration_seconds",
        "frame_count",
        "visibility",
        "visibility_rationale",
        "segment_status",
        "segment_note",
        "tagged_vlan_ids",
        "tagged_frame_count",
        "untagged_traffic_observed",
        "port_type_hint",
        "vlan_tag_note",
        "neighbors",
        "stp",
        "arp_host_count",
        "arp_bindings",
        "dhcp",
        "naming",
        "detected_sensors"
      ],
      "properties": {
        "available": { "type": "boolean" },
        "capture_interface": { "type": ["string", "null"] },
        "capture_interface_state": { "type": ["string", "null"] },
        "capture_mac": { "type": ["string", "null"] },
        "capture_ipv4": { "type": "array", "items": { "type": "string" } },
        "capture_ipv6": { "type": "array", "items": { "type": "string" } },
        "had_l3_address": { "type": ["boolean", "null"] },
        "duration_seconds": { "type": ["number", "null"] },
        "frame_count": { "type": ["integer", "null"], "minimum": 0 },
        "visibility": { "type": ["string", "null"] },
        "visibility_rationale": { "type": ["string", "null"] },
        "segment_status": {
          "type": "string",
          "enum": [
            "unknown",
            "quiet",
            "very_low",
            "tagged_vlans",
            "untagged_traffic",
            "active"
          ]
        },
        "segment_note": { "type": "string", "minLength": 1 },
        "tagged_vlan_ids": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0, "maximum": 4095 }
        },
        "tagged_frame_count": { "type": "integer", "minimum": 0 },
        "untagged_traffic_observed": { "type": "boolean" },
        "port_type_hint": { "type": ["string", "null"] },
        "vlan_tag_note": {
          "type": "string",
          "const": "VLAN в кадре виден только при 802.1Q; access-порт коммутатора часто без тега — тогда ID неизвестен, но трафик этой сети всё равно виден"
        },
        "neighbors": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "protocol",
              "name",
              "port_id",
              "native_vlan",
              "voice_vlan",
              "pvid"
            ],
            "properties": {
              "protocol": { "type": "string", "minLength": 1 },
              "name": { "type": ["string", "null"] },
              "port_id": { "type": ["string", "null"] },
              "native_vlan": { "type": ["integer", "null"] },
              "voice_vlan": { "type": ["integer", "null"] },
              "pvid": { "type": ["integer", "null"] }
            }
          }
        },
        "stp": {
          "type": "object",
          "additionalProperties": false,
          "required": ["bpdus_observed", "root_bridge_ids", "bridge_ids"],
          "properties": {
            "bpdus_observed": { "type": "integer", "minimum": 0 },
            "root_bridge_ids": {
              "type": "array",
              "items": { "type": "string" }
            },
            "bridge_ids": { "type": "array", "items": { "type": "string" } }
          }
        },
        "arp_host_count": { "type": "integer", "minimum": 0 },
        "arp_bindings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["ipv4", "mac"],
            "properties": {
              "ipv4": { "type": "string", "minLength": 1 },
              "mac": { "type": "string", "minLength": 1 }
            }
          }
        },
        "dhcp": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "observed",
            "server_count",
            "servers",
            "routers",
            "subnet_masks"
          ],
          "properties": {
            "observed": { "type": "boolean" },
            "server_count": { "type": "integer", "minimum": 0 },
            "servers": { "type": "array", "items": { "type": "string" } },
            "routers": { "type": "array", "items": { "type": "string" } },
            "subnet_masks": { "type": "array", "items": { "type": "string" } }
          }
        },
        "naming": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "status", "hits", "names", "addresses"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "status": { "type": "string", "minLength": 1 },
              "hits": { "type": "integer", "minimum": 0 },
              "names": { "type": "array", "items": { "type": "string" } },
              "addresses": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "detected_sensors": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "confirmed",
        "audit_scope",
        "profile",
        "interface",
        "targets",
        "address_count",
        "address_families",
        "timing_policy",
        "snapshot_hash"
      ],
      "properties": {
        "confirmed": { "type": "boolean" },
        "audit_scope": { "type": "object" },
        "profile": { "type": ["string", "null"] },
        "interface": { "type": ["string", "null"] },
        "targets": { "type": "array", "items": { "type": "string" } },
        "address_count": { "type": ["integer", "null"] },
        "address_families": {
          "type": "array",
          "items": { "type": "integer" }
        },
        "timing_policy": { "type": ["string", "null"] },
        "snapshot_hash": { "type": ["string", "null"] }
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "state",
          "mac",
          "vendor",
          "device_class_hint",
          "os_name",
          "addresses",
          "names"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "state": { "type": "string" },
          "mac": { "type": ["string", "null"] },
          "vendor": { "type": ["string", "null"] },
          "device_class_hint": { "type": "string" },
          "os_name": { "type": ["string", "null"] },
          "addresses": { "type": "array", "items": { "type": "string" } },
          "names": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "services": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "asset_id",
          "protocol",
          "port",
          "state",
          "service_name",
          "product",
          "version",
          "tunnel"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "asset_id": { "type": "string", "minLength": 1 },
          "protocol": { "type": "string" },
          "port": { "type": "integer", "minimum": 0 },
          "state": { "type": "string" },
          "service_name": { "type": ["string", "null"] },
          "product": { "type": ["string", "null"] },
          "version": { "type": ["string", "null"] },
          "tunnel": { "type": ["string", "null"] }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "rule_id",
          "rule_version",
          "family",
          "title",
          "severity",
          "confidence",
          "status",
          "asset_id",
          "service_id",
          "description",
          "rationale",
          "recommendation",
          "observation_ids",
          "evidence_artifact_ids",
          "data"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "rule_id": { "type": "string", "minLength": 1 },
          "rule_version": { "type": "string", "minLength": 1 },
          "family": { "type": "string" },
          "title": { "type": "string", "minLength": 1 },
          "severity": {
            "type": "string",
            "enum": ["critical", "high", "medium", "low", "info"]
          },
          "confidence": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["open", "suppressed", "accepted_risk"]
          },
          "asset_id": { "type": ["string", "null"] },
          "service_id": { "type": ["string", "null"] },
          "description": { "type": "string" },
          "rationale": { "type": "string" },
          "recommendation": { "type": "string" },
          "observation_ids": {
            "type": "array",
            "items": { "type": "string" }
          },
          "evidence_artifact_ids": {
            "type": "array",
            "items": { "type": "string" }
          },
          "data": { "type": "object" }
        }
      }
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rule_id",
          "title",
          "severity",
          "recommendation",
          "finding_ids",
          "affected_asset_ids"
        ],
        "properties": {
          "rule_id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "severity": {
            "type": "string",
            "enum": ["critical", "high", "medium", "low", "info"]
          },
          "recommendation": { "type": "string" },
          "finding_ids": { "type": "array", "items": { "type": "string" } },
          "affected_asset_ids": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "evidence_references": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "artifact_type",
          "content_type",
          "size",
          "sha256",
          "schema_name",
          "schema_version",
          "created_at"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "artifact_type": { "type": "string", "minLength": 1 },
          "content_type": { "type": "string", "minLength": 1 },
          "size": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "minLength": 64 },
          "schema_name": { "type": ["string", "null"] },
          "schema_version": { "type": ["integer", "null"] },
          "created_at": { "type": "string", "minLength": 1 }
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product",
        "version",
        "job_id",
        "actor",
        "raw_provider_output_excluded",
        "truncated",
        "input_limits",
        "warnings"
      ],
      "properties": {
        "product": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "job_id": { "type": ["string", "null"] },
        "actor": { "type": ["string", "null"] },
        "raw_provider_output_excluded": { "type": "boolean", "const": true },
        "truncated": { "type": "boolean" },
        "input_limits": {
          "type": "object",
          "additionalProperties": { "type": "integer" }
        },
        "warnings": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
